# Server Port
PORT=5000

# ==============================================================================
# DATABASE CONNECTION (Choose Option A or Option B)
# ==============================================================================

# Option A: MongoDB Atlas (Cloud - Free Tier - RECOMMENDED)
# Replace placeholders with your Atlas connection details:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Option B: Local MongoDB (Installed on your computer)
MONGO_URI=mongodb://127.0.0.1:27017/user_profile_db

# ==============================================================================
# SECURITY / JWT CONFIGURATION
# ==============================================================================
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend client URL (for CORS)
CLIENT_URL=http://localhost:5173
